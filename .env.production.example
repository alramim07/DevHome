APP_NAME="Dev Home"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (MySQL; free no-card option: Aiven Free MySQL) ---
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Managed MySQL (Aiven, TiDB, ...) requires TLS. Paste the provider's CA
# certificate here — raw PEM (DB_SSL_CA_PEM) or base64 (DB_SSL_CA_PEM_B64).
# The container writes it to disk and points the MySQL PDO driver at it.
DB_SSL_CA_PEM=
DB_SSL_CA_PEM_B64=

# --- Session / cache / queue (database driver; tables are migrated) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# --- Filesystem / uploads ---
# Free hosts with an ephemeral disk (e.g. Render free) must keep uploads on
# durable object storage. Set PUBLIC_DISK_DRIVER=s3 to route the "public" disk
# to any S3-compatible provider (Supabase, Cloudflare R2, Backblaze B2, ...).
PUBLIC_DISK_DRIVER=local
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail (only needed if you enable mail sending) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
